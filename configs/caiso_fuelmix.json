{
  "dataset": {
    "region_name": "CAISO",
    "enforce_asof_publication": true,
    "clip_negative_fuel_values": true,
    "fuel_cols": [
      "nat_gas",
      "nuclear",
      "hydro",
      "wind",
      "solar",
      "geothermal",
      "biomass",
      "biogas",
      "imports",
      "battery"
    ],
    "fuel_col_map": {
      "natural_gas": "nat_gas",
      "nuclear": "nuclear",
      "small_hydro": "hydro",
      "large_hydro": "hydro",
      "wind": "wind",
      "solar": "solar",
      "geothermal": "geothermal",
      "biomass": "biomass",
      "biogas": "biogas",
      "imports": "imports",
      "batteries": "battery"
    },
    "load_locations": [],
    "load_col": "load_forecast",
    "required_forecast_lead_hours": 0,
    "accounting_notes": {
      "imports": "Positive net imports use the 0.40 tCO2/MWh base assumption; negative exports are clipped.",
      "battery": "Positive discharge has zero direct operational emissions; charging is clipped.",
      "other": "Dropped because the 2024 series is identically zero."
    },
    "max_load_interpolation_hours": 6,
    "load_filter_col": "tac_area_name",
    "load_filter_value": "CA ISO-TAC"
  },
  "paths": {
    "fuel_mix_csv": [
      "data/CAISO/_raw/CAISO_fuel_mix_raw.csv",
      "data/CAISO/_raw_2025/CAISO_fuel_mix_raw.csv"
    ],
    "load_forecast_csv": [
      "data/CAISO/_raw/CAISO_load_forecast_asof0_raw.csv",
      "data/CAISO/_raw_2025/CAISO_load_forecast_asof0_raw.csv"
    ]
  },
  "features": {
    "system_load": true,
    "time": true,
    "load_lags": true,
    "historical_fuel_lags": true,
    "historical_lag_hours": [
      1,
      24
    ],
    "zonal_load": false,
    "zonal_percentage": false,
    "renewable_forecast": false,
    "weather": false
  },
  "emission_factors": {
    "nat_gas": 0.4,
    "nuclear": 0.0,
    "hydro": 0.0,
    "wind": 0.0,
    "solar": 0.0,
    "geothermal": 0.0,
    "biomass": 0.0,
    "biogas": 0.45,
    "imports": 0.4,
    "battery": 0.0
  },
  "fossil_fuels": [
    "nat_gas",
    "biogas"
  ],
  "loss_weights": {
    "fuel": 1.0,
    "ci": 50.0,
    "balance": 0.2,
    "fossil": 0.5
  },
  "data_source": {
    "provider": "gridstatusio",
    "start_date": "2024-01-02",
    "end_date": "2026-01-01",
    "chunk_days": 30,
    "sleep_sec": 2,
    "fuel_mix": {
      "dataset": "caiso_fuel_mix",
      "resample": "1h"
    },
    "load_forecast": {
      "dataset": "caiso_load_forecast",
      "resample": "1h"
    }
  },
  "split": {
    "train_frac": 0.7,
    "val_frac": 0.15,
    "test_frac": 0.15
  },
  "model": {
    "hidden_size": 128
  },
  "training": {
    "learning_rate": 0.001,
    "batch_size": 64,
    "max_epochs": 40,
    "patience": 5
  },
  "output": {
    "save_dir": "results/fuelmix/caiso"
  },
  "debug": {
    "max_samples": null
  }
}
